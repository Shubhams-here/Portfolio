# Port for the Express server to listen on
PORT=5000

# MongoDB Connection String (Atlas URI in production)
MONGO_URI=mongodb://127.0.0.1:27017/portfolio_shubham

# Resend API Key for sending emails (HTTP-based, bypasses Render SMTP block)
RESEND_API_KEY=re_your_api_key_here

# Email Address to receive contact form submission details
EMAIL_RECEIVER=shubhamsinghrajput7809@gmail.com

# Allowed Frontend URL for CORS (Required in production)
FRONTEND_URL=https://shubhambuilds.vercel.app

# Node environment state (development/production)
NODE_ENV=production
